{
  "name": "pagerecast",
  "version": "1.4.0",
  "private": true,
  "description": "Turn any web page into editable Figma layers. A free, open-source Chrome extension and Figma plugin.",
  "license": "MIT",
  "author": "Shades Media Group (https://shades.md)",
  "homepage": "https://github.com/Shades-Media-Group/PageRecast#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shades-Media-Group/PageRecast.git"
  },
  "bugs": "https://github.com/Shades-Media-Group/PageRecast/issues",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:extension": "yarn --cwd apps/extension dev",
    "dev:plugin": "yarn --cwd apps/figma-plugin dev",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/figma-plugin/tsconfig.main.json",
    "lint": "eslint . --cache",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "yarn --cwd apps/extension build && yarn build:firefox && yarn --cwd apps/figma-plugin build && yarn --cwd packages/cli build && yarn --cwd packages/mcp build",
    "build:firefox": "yarn --cwd apps/extension build:firefox",
    "cli": "node packages/cli/build.mjs && node packages/cli/dist/pagerecast.mjs",
    "mcp": "node packages/mcp/build.mjs && node packages/mcp/dist/pagerecast-mcp.mjs",
    "package": "node scripts/package.mjs",
    "verify": "yarn typecheck && yarn lint && yarn test && yarn build && yarn build:site",
    "format": "prettier --write .",
    "release": "node scripts/release.mjs",
    "brand": "node scripts/brand.mjs",
    "dev:site": "yarn --cwd apps/site dev",
    "build:site": "yarn --cwd apps/site build",
    "deploy:site": "yarn --cwd apps/site deploy"
  },
  "packageManager": "yarn@1.22.22",
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@figma/plugin-typings": "^1.141.0",
    "@fontsource-variable/inter": "5",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "preact": "^10",
    "shades-gradient": "https://github.com/Shades-Media-Group/gradient/releases/download/v0.9.1/shades-gradient-0.9.1.tgz"
  },
  "type": "module",
  "keywords": [
    "figma",
    "figma-plugin",
    "chrome-extension",
    "html-to-figma",
    "website-to-figma",
    "design-tools",
    "web-to-design"
  ]
}
